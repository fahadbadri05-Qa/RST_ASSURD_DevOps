{
  "request": {
    "method": "POST",
    "url": "/auth",
    "bodyPatterns": [
      {
        "equalToJson": "{\"username\":\"admin\",\"password\":\"password123\"}"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "jsonBody": {
      "token": "mock-token-12345"
    }
  }
}
